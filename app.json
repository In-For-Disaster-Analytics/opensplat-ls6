{
  "id": "opensplat-ls6",
  "version": "0.1.1",
  "description": "OpenSplat Gaussian-splatting batch processing on TACC Lonestar6.",
  "owner": "${apiUserId}",
  "enabled": true,
  "runtime": "ZIP",
  "runtimeVersion": "",
  "containerImage": "tapis://cloud.data/corral-repl/utexas/BCS26030/NodeODX/opensplat-ls6.zip",
  "jobType": "BATCH",
  "maxJobs": -1,
  "maxJobsPerUser": 4,
  "strictFileInputs": false,
  "jobAttributes": {
    "description": null,
    "dynamicExecSystem": false,
    "execSystemConstraints": null,
    "execSystemId": "ls6",
    "execSystemExecDir": "${JobWorkingDir}",
    "execSystemInputDir": "${JobWorkingDir}/inputs",
    "execSystemOutputDir": "${JobWorkingDir}/output",
    "execSystemLogicalQueue": "gpu-a100-small",
    "archiveSystemId": "cloud.data",
    "archiveSystemDir": "HOST_EVAL($SCRATCH)/tapis-jobs-archive/${JobCreateDate}/${JobName}-${JobUUID}",
    "archiveOnAppError": true,
    "isMpi": false,
    "parameterSet": {
      "appArgs": [
        {"name": "input_path", "description": "Absolute path to an ODX/OpenSfM project visible on LS6; replace the placeholder with the project path.", "inputMode": "INCLUDE_ON_DEMAND", "arg": "/var/www/data/PROJECT_ID"},
        {"name": "num_iterations", "description": "OpenSplat training iterations.", "inputMode": "INCLUDE_ON_DEMAND", "arg": "2000"}
      ],
      "schedulerOptions": [
        {"name": "TACC Scheduler Profile", "description": "Scheduler profile for HPC clusters at TACC", "inputMode": "FIXED", "arg": "--tapis-profile tacc-apptainer", "notes": {"isHidden": true}},
        {"name": "TAP Session Substring", "description": "TAP Functions require the substring 'tap_' in the Slurm job name.", "inputMode": "FIXED", "arg": "--job-name ${JobName}-tap_", "notes": {"isHidden": true}}
      ],
      "envVariables": [],
      "archiveFilter": {"includes": [], "excludes": [], "includeLaunchFiles": true}
    },
    "fileInputs": [],
    "fileInputArrays": [],
    "nodeCount": 1,
    "coresPerNode": 16,
    "memoryMB": 30720,
    "maxMinutes": 240,
    "subscriptions": [],
    "tags": []
  },
  "tags": ["portalName: ALL"],
  "notes": {
    "label": "OpenSplat on LS6",
    "helpUrl": "https://github.com/WebODM/OpenSplat",
    "helpText": "Standalone OpenSplat batch processing for ODX/OpenSfM reconstruction projects. Produces one validated .ply or .splat scene artifact per job.",
    "hideNodeCountAndCoresPerNode": false,
    "isInteractive": false,
    "icon": "camera",
    "category": "Data Processing",
    "queueFilter": ["gpu-a100-small", "gpu-a100", "gpu-a100-dev"]
  }
}
